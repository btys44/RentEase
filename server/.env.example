# PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentease?schema=public"

# JWT
JWT_SECRET="replace_this_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
CLIENT_URL="http://localhost:5173"

# Africa's Talking (SMS) - leave blank to use mock mode
AT_USERNAME=""
AT_API_KEY=""

# Daraja M-Pesa API - leave blank to use mock mode
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:5000/api/payments/mpesa/callback"

# Uploads
UPLOAD_DIR="uploads"
